{
  "entities": {
    "UserProgress": {
      "title": "UserProgress",
      "description": "Private player progression and personal records for a signed-in builder.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the player."
        },
        "playerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Display name of the builder."
        },
        "bestScore": {
          "type": "integer",
          "description": "Highest score achieved."
        },
        "highestLevel": {
          "type": "integer",
          "description": "Highest city tier reached (1-10)."
        },
        "totalBuilt": {
          "type": "integer",
          "description": "Cumulative landmarks constructed."
        },
        "questsCompleted": {
          "type": "integer",
          "description": "Total district quests completed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "uid",
        "playerName",
        "bestScore",
        "highestLevel",
        "totalBuilt",
        "questsCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public non-PII online leaderboard entry keyed by player UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the player."
        },
        "playerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Public builder callsign."
        },
        "score": {
          "type": "integer",
          "description": "Best verified city score."
        },
        "cityLevel": {
          "type": "integer",
          "description": "City progression tier achieved."
        },
        "landmarksCount": {
          "type": "integer",
          "description": "Landmarks built in best run."
        },
        "maxCombo": {
          "type": "integer",
          "description": "Highest spark combo streak."
        },
        "districtTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Unlocked district rank title."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the record update."
        }
      },
      "required": [
        "uid",
        "playerName",
        "score",
        "cityLevel",
        "landmarksCount",
        "maxCombo",
        "districtTitle",
        "updatedAt"
      ]
    },
    "MultiplayerRoom": {
      "title": "MultiplayerRoom",
      "description": "Lobby and matchmaking metadata for a WebRTC P2P multiplayer room (max 6-8 players).",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "code": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12
        },
        "mode": {
          "type": "string",
          "enum": ["group", "public"]
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "playing"]
        },
        "hostUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "difficulty": {
          "type": "string",
          "enum": ["santai", "petualang", "pendekar"]
        },
        "maxPlayers": {
          "type": "integer"
        },
        "memberCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "roomId",
        "code",
        "mode",
        "status",
        "hostUid",
        "hostName",
        "difficulty",
        "maxPlayers",
        "memberCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "MultiplayerMember": {
      "title": "MultiplayerMember",
      "description": "Player membership and selected character inside a multiplayer room.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "characterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "spawnIndex": {
          "type": "integer"
        },
        "isHost": {
          "type": "boolean"
        },
        "online": {
          "type": "boolean"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "roomId",
        "displayName",
        "characterId",
        "spawnIndex",
        "isHost",
        "online",
        "joinedAt",
        "updatedAt"
      ]
    },
    "WebRtcSignal": {
      "title": "WebRtcSignal",
      "description": "Ephemeral WebRTC SDP/ICE signaling packet relayed between two peers in a room.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "toUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": ["offer", "answer", "ice"]
        },
        "payload": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8192
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "roomId",
        "fromUid",
        "toUid",
        "kind",
        "payload",
        "createdAt"
      ]
    },
    "RoomChatMessage": {
      "title": "RoomChatMessage",
      "description": "Lightweight fallback room chat message when a peer DataChannel is not yet connected.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "roomId",
        "senderUid",
        "senderName",
        "text",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProgress"
      },
      "description": "Owner-only progression records for each player."
    },
    "/leaderboard/{userId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Global online leaderboard rankings (non-PII)."
    },
    "/rooms/{roomId}": {
      "schema": {
        "$ref": "#/entities/MultiplayerRoom"
      },
      "description": "Multiplayer lobby rooms for group codes and public matchmaking."
    },
    "/rooms/{roomId}/members/{memberId}": {
      "schema": {
        "$ref": "#/entities/MultiplayerMember"
      },
      "description": "Active members inside a multiplayer room."
    },
    "/rooms/{roomId}/signals/{signalId}": {
      "schema": {
        "$ref": "#/entities/WebRtcSignal"
      },
      "description": "Ephemeral WebRTC SDP/ICE signaling documents deleted after consumption."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/RoomChatMessage"
      },
      "description": "Fallback room text chat when P2P DataChannel is unavailable."
    }
  }
}
